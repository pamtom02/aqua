ENVIRONMENT=development
DATABASE_URL=postgresql://aquabloom:CHANGE_ME@localhost:5432/aquabloom
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_FERNET_KEY
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET
STORAGE_ROOT=./private-data
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
ALLOW_REGISTRATION=false
# Optional initial account; remove these two variables after provisioning.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
